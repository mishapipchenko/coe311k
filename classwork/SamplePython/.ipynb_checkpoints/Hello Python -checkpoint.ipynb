   "source": [
    "import random\n",
    "N = 1000\n",
    "ins = 0 \n",
    "\n",
    "for i in range(N):\n",
    "    x = random.uniform(-1, 1)\n",
    "    y = random.uniform(-1, 1)\n",
    "    \n",
    "     if x*x + y*y <= 1:\n",
    "        ins = ins + 1\n",
    "\n",
    "pi = 4 * ins / N\n",
    "print(pi)"
